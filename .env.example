# Optional overrides for pipeline input/output locations.
# Copy to `.env` and adjust if you want the pipeline to read/write
# somewhere other than the default project-relative folders.
# No secrets are required by this project -- these are plain file paths.

# PIPELINE_DATA_DIR=./data
# PIPELINE_OUTPUT_DIR=./outputs
# PIPELINE_REPORTS_DIR=./reports
# PIPELINE_LOGS_DIR=./logs
